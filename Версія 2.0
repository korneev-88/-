<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Deep Space Explorer</title>

<style>
body{
    margin:0;
    overflow:hidden;
    background:black;
}

canvas{
    display:block;
    background:
    radial-gradient(circle at center,#050816,#000000);
}
</style>
</head>

<body>

<canvas id="game"></canvas>

<script>
const canvas = document.getElementById("game");
const ctx = canvas.getContext("2d");

canvas.width = window.innerWidth;
canvas.height = window.innerHeight;

// ===== СВІТ =====
const world = {
    width: 10000,
    height: 10000
};

// ===== КЛАВІШІ =====
let keys = {};

document.addEventListener("keydown", e=>{
    keys[e.key] = true;
});

document.addEventListener("keyup", e=>{
    keys[e.key] = false;
});

// ===== РАКЕТА =====
const rocket = {

    x: world.width / 2,
    y: world.height / 2,

    vx: 0,
    vy: 0,

    angle: 0,

    thrust: 0.18,
    rotation: 0.05,

    radius: 25
};

// ===== КАМЕРА =====
const camera = {
    x: 0,
    y: 0
};

// ===== ОБ'ЄКТИ =====
let stars = [];
let farStars = [];
let nebulas = [];
let planets = [];
let debris = [];
let particles = [];

// ===== ЗІРКИ =====
for(let i=0;i<5000;i++){

    stars.push({

        x: Math.random()*world.width,
        y: Math.random()*world.height,

        size: Math.random()*2,

        brightness:
        100 + Math.random()*155
    });
}

// ===== ДАЛЕКІ ЗІРКИ =====
for(let i=0;i<3000;i++){

    farStars.push({

        x: Math.random()*world.width,
        y: Math.random()*world.height,

        size: Math.random()*1.5
    });
}

// ===== ТУМАННОСТІ =====
for(let i=0;i<25;i++){

    nebulas.push({

        x: Math.random()*world.width,
        y: Math.random()*world.height,

        radius: 300 + Math.random()*600,

        color:
        `rgba(
            ${50 + Math.random()*200},
            ${20 + Math.random()*100},
            ${100 + Math.random()*155},
            0.12
        )`
    });
}

// ===== ПЛАНЕТИ =====
for(let i=0;i<15;i++){

    planets.push({

        x: Math.random()*world.width,
        y: Math.random()*world.height,

        radius: 80 + Math.random()*220,

        color:
        `hsl(${Math.random()*360},
             70%,
             50%)`
    });
}

// ===== СМІТТЯ =====
for(let i=0;i<1200;i++){

    debris.push({

        x: Math.random()*world.width,
        y: Math.random()*world.height,

        size: 15 + Math.random()*80,

        rotation: Math.random()*Math.PI*2,
        rotSpeed: (Math.random()-0.5)*0.03,

        type: Math.floor(Math.random()*7)
    });
}

// ===== КАМЕРА =====
function updateCamera(){

    camera.x =
    rocket.x - canvas.width/2;

    camera.y =
    rocket.y - canvas.height/2;
}

// ===== ДАЛЕКІ ЗІРКИ =====
function drawFarStars(){

    ctx.fillStyle = "#888";

    for(let s of farStars){

        const x =
        s.x - camera.x * 0.2;

        const y =
        s.y - camera.y * 0.2;

        ctx.fillRect(
            x,
            y,
            s.size,
            s.size
        );
    }
}

// ===== ТУМАННОСТІ =====
function drawNebulas(){

    for(let n of nebulas){

        const x =
        n.x - camera.x * 0.6;

        const y =
        n.y - camera.y * 0.6;

        const gradient =
        ctx.createRadialGradient(
            x,y,0,
            x,y,n.radius
        );

        gradient.addColorStop(
            0,
            n.color
        );

        gradient.addColorStop(
            1,
            "transparent"
        );

        ctx.fillStyle = gradient;

        ctx.beginPath();

        ctx.arc(
            x,
            y,
            n.radius,
            0,
            Math.PI*2
        );

        ctx.fill();
    }
}

// ===== ЗІРКИ =====
function drawStars(){

    for(let s of stars){

        const x = s.x - camera.x;
        const y = s.y - camera.y;

        if(
            x < 0 ||
            x > canvas.width ||
            y < 0 ||
            y > canvas.height
        ){
            continue;
        }

        ctx.fillStyle =
        `rgb(
            ${s.brightness},
            ${s.brightness},
            ${s.brightness}
        )`;

        ctx.beginPath();

        ctx.arc(
            x,
            y,
            s.size,
            0,
            Math.PI*2
        );

        ctx.fill();
    }
}

// ===== ПЛАНЕТИ =====
function drawPlanets(){

    for(let p of planets){

        const x =
        p.x - camera.x * 0.8;

        const y =
        p.y - camera.y * 0.8;

        const gradient =
        ctx.createRadialGradient(
            x-p.radius*0.3,
            y-p.radius*0.3,
            10,
            x,
            y,
            p.radius
        );

        gradient.addColorStop(0,"white");
        gradient.addColorStop(0.2,p.color);
        gradient.addColorStop(1,"black");

        ctx.fillStyle = gradient;

        ctx.beginPath();

        ctx.arc(
            x,
            y,
            p.radius,
            0,
            Math.PI*2
        );

        ctx.fill();

        // кільця
        if(p.radius > 150){

            ctx.strokeStyle =
            "rgba(255,255,255,0.25)";

            ctx.lineWidth = 6;

            ctx.beginPath();

            ctx.ellipse(
                x,
                y,
                p.radius*1.6,
                p.radius*0.45,
                Math.PI/4,
                0,
                Math.PI*2
            );

            ctx.stroke();
        }
    }
}

// ===== РАКЕТА =====
function drawRocket(){

    ctx.save();

    ctx.translate(
        rocket.x - camera.x,
        rocket.y - camera.y
    );

    ctx.rotate(rocket.angle);

    // світіння
    ctx.shadowColor = "#00cfff";
    ctx.shadowBlur = 20;

    // корпус
    ctx.fillStyle = "#d9d9d9";

    ctx.beginPath();
    ctx.moveTo(40,0);
    ctx.lineTo(-30,-22);
    ctx.lineTo(-20,0);
    ctx.lineTo(-30,22);
    ctx.closePath();
    ctx.fill();

    // ніс
    ctx.fillStyle = "red";

    ctx.beginPath();
    ctx.moveTo(45,0);
    ctx.lineTo(20,-12);
    ctx.lineTo(20,12);
    ctx.closePath();
    ctx.fill();

    // кабіна
    ctx.fillStyle = "#66d9ff";

    ctx.beginPath();
    ctx.arc(5,0,8,0,Math.PI*2);
    ctx.fill();

    // крила
    ctx.fillStyle = "#666";

    ctx.beginPath();
    ctx.moveTo(-15,-15);
    ctx.lineTo(-42,-35);
    ctx.lineTo(-18,-5);
    ctx.fill();

    ctx.beginPath();
    ctx.moveTo(-15,15);
    ctx.lineTo(-42,35);
    ctx.lineTo(-18,5);
    ctx.fill();

    // двигун
    if(keys["ArrowUp"]){

        ctx.fillStyle = "orange";

        ctx.beginPath();
        ctx.moveTo(-30,-10);
        ctx.lineTo(-85-Math.random()*20,0);
        ctx.lineTo(-30,10);
        ctx.fill();

        ctx.fillStyle = "yellow";

        ctx.beginPath();
        ctx.moveTo(-30,-5);
        ctx.lineTo(-65-Math.random()*10,0);
        ctx.lineTo(-30,5);
        ctx.fill();
    }

    ctx.restore();
}

// ===== РУХ =====
function moveRocket(){

    if(keys["ArrowLeft"]){
        rocket.angle -= rocket.rotation;
    }

    if(keys["ArrowRight"]){
        rocket.angle += rocket.rotation;
    }

    if(keys["ArrowUp"]){

        rocket.vx +=
        Math.cos(rocket.angle) *
        rocket.thrust;

        rocket.vy +=
        Math.sin(rocket.angle) *
        rocket.thrust;

        particles.push({

            x:
            rocket.x -
            Math.cos(rocket.angle)*35,

            y:
            rocket.y -
            Math.sin(rocket.angle)*35,

            vx:
            -Math.cos(rocket.angle)*4 +
            (Math.random()-0.5)*2,

            vy:
            -Math.sin(rocket.angle)*4 +
            (Math.random()-0.5)*2,

            life: 20
        });
    }

    rocket.x += rocket.vx;
    rocket.y += rocket.vy;

    rocket.vx *= 0.992;
    rocket.vy *= 0.992;

    // межі
    if(rocket.x < 0) rocket.x = 0;
    if(rocket.y < 0) rocket.y = 0;

    if(rocket.x > world.width){
        rocket.x = world.width;
    }

    if(rocket.y > world.height){
        rocket.y = world.height;
    }
}

// ===== СМІТТЯ =====
function drawDebris(){

    for(let d of debris){

        const x = d.x - camera.x;
        const y = d.y - camera.y;

        if(
            x < -200 ||
            x > canvas.width + 200 ||
            y < -200 ||
            y > canvas.height + 200
        ){
            continue;
        }

        ctx.save();

        ctx.translate(x,y);
        ctx.rotate(d.rotation);

        // астероїд
        if(d.type === 0){

            ctx.fillStyle = "#666";

            ctx.beginPath();

            for(let i=0;i<10;i++){

                const angle =
                i * Math.PI * 2 / 10;

                const radius =
                d.size/2 +
                Math.random()*10;

                const px =
                Math.cos(angle)*radius;

                const py =
                Math.sin(angle)*radius;

                if(i===0){
                    ctx.moveTo(px,py);
                }else{
                    ctx.lineTo(px,py);
                }
            }

            ctx.closePath();
            ctx.fill();
        }

        // супутник
        if(d.type === 1){

            ctx.fillStyle = "#bbb";

            ctx.fillRect(-15,-15,30,30);

            ctx.fillStyle = "#00bfff";

            ctx.fillRect(-55,-12,35,24);
            ctx.fillRect(20,-12,35,24);
        }

        // уламок
        if(d.type === 2){

            ctx.fillStyle = "#777";

            ctx.beginPath();

            ctx.moveTo(-30,-20);
            ctx.lineTo(25,-25);
            ctx.lineTo(40,10);
            ctx.lineTo(-20,30);

            ctx.closePath();
            ctx.fill();
        }

        // міна
        if(d.type === 3){

            ctx.fillStyle = "#333";

            ctx.beginPath();

            ctx.arc(
                0,
                0,
                d.size/2,
                0,
                Math.PI*2
            );

            ctx.fill();

            ctx.strokeStyle = "red";

            for(let i=0;i<8;i++){

                const angle =
                i*Math.PI*2/8;

                ctx.beginPath();

                ctx.moveTo(
                    Math.cos(angle)*d.size/2,
                    Math.sin(angle)*d.size/2
                );

                ctx.lineTo(
                    Math.cos(angle)*(d.size/2+15),
                    Math.sin(angle)*(d.size/2+15)
                );

                ctx.stroke();
            }
        }

        // бочка
        if(d.type === 4){

            ctx.fillStyle = "#995500";

            ctx.beginPath();

            ctx.arc(
                0,
                0,
                d.size/2,
                0,
                Math.PI*2
            );

            ctx.fill();
        }

        // антена
        if(d.type === 5){

            ctx.strokeStyle = "#ddd";
            ctx.lineWidth = 4;

            ctx.beginPath();
            ctx.moveTo(-40,0);
            ctx.lineTo(40,0);
            ctx.stroke();

            ctx.beginPath();
            ctx.arc(0,0,20,0,Math.PI*2);
            ctx.stroke();
        }

        // уламки корабля
        if(d.type === 6){

            ctx.fillStyle = "#555";

            ctx.fillRect(-30,-15,60,30);

            ctx.fillStyle = "#222";

            ctx.fillRect(-10,-10,20,20);
        }

        ctx.restore();

        d.rotation += d.rotSpeed;
    }
}

// ===== КОЛІЗІЇ =====
function checkCollision(){

    for(let d of debris){

        const dx =
        rocket.x - d.x;

        const dy =
        rocket.y - d.y;

        const distance =
        Math.sqrt(dx*dx + dy*dy);

        if(
            distance <
            d.size/2 + rocket.radius
        ){

            alert("GAME OVER");

            location.reload();
        }
    }
}

// ===== ЧАСТИНКИ =====
function drawParticles(){

    for(let p of particles){

        ctx.fillStyle =
        "rgba(255,140,0," +
        (p.life/20) + ")";

        ctx.beginPath();

        ctx.arc(
            p.x - camera.x,
            p.y - camera.y,
            3,
            0,
            Math.PI*2
        );

        ctx.fill();

        p.x += p.vx;
        p.y += p.vy;

        p.life--;
    }

    particles =
    particles.filter(
        p => p.life > 0
    );
}

// ===== UI =====
function drawUI(){

    ctx.fillStyle = "white";

    ctx.font = "28px Arial";

    ctx.fillText(
        "X: " +
        Math.floor(rocket.x),
        20,
        40
    );

    ctx.fillText(
        "Y: " +
        Math.floor(rocket.y),
        20,
        75
    );

    ctx.fillText(
        "Speed: " +
        Math.floor(
            Math.sqrt(
                rocket.vx*rocket.vx +
                rocket.vy*rocket.vy
            ) * 10
        ),
        20,
        110
    );
}

// ===== ЦИКЛ =====
function gameLoop(){

    ctx.clearRect(
        0,
        0,
        canvas.width,
        canvas.height
    );

    moveRocket();

    updateCamera();

    drawFarStars();

    drawNebulas();

    drawStars();

    drawPlanets();

    drawDebris();

    drawRocket();

    checkCollision();

    drawParticles();

    drawUI();

    requestAnimationFrame(
        gameLoop
    );
}

gameLoop();
</script>

</body>
</html>
