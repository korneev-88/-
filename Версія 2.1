<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Space Explorer</title>

<style>
body{
    margin:0;
    overflow:hidden;
    background:black;
}

canvas{
    display:block;
    background:#020814;
}
</style>
</head>

<body>

<canvas id="game"></canvas>

<script>

const canvas = document.getElementById("game");
const ctx = canvas.getContext("2d");

canvas.width = window.innerWidth;
canvas.height = window.innerHeight;

const world = {
    width:10000,
    height:10000
};

let keys = {};

document.addEventListener("keydown",e=>{
    keys[e.key]=true;
});

document.addEventListener("keyup",e=>{
    keys[e.key]=false;
});

let coins = 0;

let health = 10;
let maxHealth = 10;

let gameOver = false;

const rocket = {

    x:world.width/2,
    y:world.height/2,

    vx:0,
    vy:0,

    angle:0,

    thrust:0.18,
    rotation:0.05,

    radius:25
};

const camera = {
    x:0,
    y:0
};

let stars = [];
let farStars = [];
let nebulas = [];
let planets = [];

let debris = [];
let particles = [];

let coinObjects = [];
let stations = [];

for(let i=0;i<5000;i++){

    stars.push({

        x:Math.random()*world.width,
        y:Math.random()*world.height,

        size:Math.random()*2+1
    });
}

for(let i=0;i<3000;i++){

    farStars.push({

        x:Math.random()*world.width,
        y:Math.random()*world.height,

        size:Math.random()*1.5
    });
}

for(let i=0;i<20;i++){

    nebulas.push({

        x:Math.random()*world.width,
        y:Math.random()*world.height,

        radius:250+Math.random()*500,

        color:
        `rgba(
        ${50+Math.random()*200},
        ${50+Math.random()*100},
        ${100+Math.random()*155},
        0.15)`
    });
}

for(let i=0;i<15;i++){

    planets.push({

        x:Math.random()*world.width,
        y:Math.random()*world.height,

        radius:80+Math.random()*200,

        color:
        `hsl(${Math.random()*360},70%,50%)`
    });
}

for(let i=0;i<300;i++){

    coinObjects.push({

        x:Math.random()*world.width,
        y:Math.random()*world.height,

        radius:12
    });
}

for(let i=0;i<20;i++){

    stations.push({

        x:Math.random()*world.width,
        y:Math.random()*world.height
    });
}

function updateCamera(){

    camera.x =
    rocket.x - canvas.width/2;

    camera.y =
    rocket.y - canvas.height/2;
}

function moveRocket(){

    if(gameOver) return;

    if(keys["ArrowLeft"]){

        rocket.angle -= rocket.rotation;
    }

    if(keys["ArrowRight"]){

        rocket.angle += rocket.rotation;
    }

    if(keys["ArrowUp"]){

        rocket.vx +=
        Math.cos(rocket.angle) *
        rocket.thrust;

        rocket.vy +=
        Math.sin(rocket.angle) *
        rocket.thrust;

        particles.push({

            x:rocket.x,
            y:rocket.y,

            vx:(Math.random()-0.5)*3,
            vy:(Math.random()-0.5)*3,

            life:20
        });
    }

    rocket.x += rocket.vx;
    rocket.y += rocket.vy;

    rocket.vx *= 0.992;
    rocket.vy *= 0.992;
}

function drawFarStars(){

    ctx.fillStyle="#666";

    for(let s of farStars){

        ctx.fillRect(
            s.x-camera.x*0.2,
            s.y-camera.y*0.2,
            s.size,
            s.size
        );
    }
}

function drawNebulas(){

    for(let n of nebulas){

        const x =
        n.x-camera.x*0.6;

        const y =
        n.y-camera.y*0.6;

        const g =
        ctx.createRadialGradient(
            x,y,0,
            x,y,n.radius
        );

        g.addColorStop(0,n.color);
        g.addColorStop(1,"transparent");

        ctx.fillStyle=g;

        ctx.beginPath();
        ctx.arc(
            x,y,n.radius,
            0,Math.PI*2
        );
        ctx.fill();
    }
}

function drawStars(){

    ctx.fillStyle="white";

    for(let s of stars){

        ctx.fillRect(
            s.x-camera.x,
            s.y-camera.y,
            s.size,
            s.size
        );
    }
}

function drawPlanets(){

    for(let p of planets){

        const x =
        p.x-camera.x*0.8;

        const y =
        p.y-camera.y*0.8;

        ctx.fillStyle=p.color;

        ctx.beginPath();
        ctx.arc(
            x,y,p.radius,
            0,Math.PI*2
        );
        ctx.fill();
    }
}

function drawRocket(){

    ctx.save();

    ctx.translate(
        rocket.x-camera.x,
        rocket.y-camera.y
    );

    ctx.rotate(
        rocket.angle
    );

    ctx.fillStyle="#d9d9d9";

    ctx.beginPath();
    ctx.moveTo(40,0);
    ctx.lineTo(-30,-20);
    ctx.lineTo(-15,0);
    ctx.lineTo(-30,20);
    ctx.closePath();
    ctx.fill();

    ctx.fillStyle="red";

    ctx.beginPath();
    ctx.moveTo(45,0);
    ctx.lineTo(20,-10);
    ctx.lineTo(20,10);
    ctx.closePath();
    ctx.fill();

    ctx.restore();
}

function drawCoins(){

    for(let c of coinObjects){

        ctx.fillStyle="gold";

        ctx.beginPath();

        ctx.arc(
            c.x-camera.x,
            c.y-camera.y,
            c.radius,
            0,
            Math.PI*2
        );

        ctx.fill();
    }
}

function collectCoins(){

    coinObjects =
    coinObjects.filter(c=>{

        const dx =
        rocket.x-c.x;

        const dy =
        rocket.y-c.y;

        const d =
        Math.sqrt(dx*dx+dy*dy);

        if(d<40){

            coins++;
            return false;
        }

        return true;
    });
}

function drawStations(){

    for(let s of stations){

        ctx.fillStyle="#00aaff";

        ctx.beginPath();

        ctx.arc(
            s.x-camera.x,
            s.y-camera.y,
            40,
            0,
            Math.PI*2
        );

        ctx.fill();
    }
}

for(let i=0;i<800;i++){

    debris.push({

        x:Math.random()*world.width,
        y:Math.random()*world.height,

        size:15+Math.random()*70,

        rotation:Math.random()*Math.PI*2,

        rotSpeed:
        (Math.random()-0.5)*0.03,

        type:
        Math.floor(Math.random()*7),

        cooldown:0
    });
}

function drawDebris(){

    for(let d of debris){

        const x =
        d.x-camera.x;

        const y =
        d.y-camera.y;

        ctx.save();

        ctx.translate(x,y);

        ctx.rotate(d.rotation);

        if(d.type===0){

            ctx.fillStyle="#666";

            ctx.beginPath();

            for(let i=0;i<10;i++){

                const a=
                i*Math.PI*2/10;

                const r=
                d.size/2+
                Math.random()*8;

                const px=
                Math.cos(a)*r;

                const py=
                Math.sin(a)*r;

                if(i===0){

                    ctx.moveTo(px,py);

                }else{

                    ctx.lineTo(px,py);
                }
            }

            ctx.closePath();
            ctx.fill();
        }

        if(d.type===1){

            ctx.fillStyle="#aaa";

            ctx.fillRect(
                -15,-15,
                30,30
            );

            ctx.fillStyle=
            "#00bfff";

            ctx.fillRect(
                -50,-10,
                30,20
            );

            ctx.fillRect(
                20,-10,
                30,20
            );
        }

        if(d.type===2){

            ctx.fillStyle="#777";

            ctx.beginPath();

            ctx.moveTo(-30,-20);
            ctx.lineTo(25,-25);
            ctx.lineTo(40,10);
            ctx.lineTo(-20,30);

            ctx.closePath();
            ctx.fill();
        }

        if(d.type===3){

            ctx.fillStyle=
            "#444";

            ctx.beginPath();

            ctx.arc(
                0,0,
                d.size/2,
                0,
                Math.PI*2
            );

            ctx.fill();

            ctx.strokeStyle=
            "red";

            for(let i=0;i<8;i++){

                const a=
                i*Math.PI*2/8;

                ctx.beginPath();

                ctx.moveTo(
                    Math.cos(a)*
                    d.size/2,

                    Math.sin(a)*
                    d.size/2
                );

                ctx.lineTo(
                    Math.cos(a)*
                    (d.size/2+15),

                    Math.sin(a)*
                    (d.size/2+15)
                );

                ctx.stroke();
            }
        }

        if(d.type===4){

            ctx.fillStyle=
            "#995500";

            ctx.beginPath();

            ctx.arc(
                0,0,
                d.size/2,
                0,
                Math.PI*2
            );

            ctx.fill();
        }

        if(d.type===5){

            ctx.strokeStyle=
            "#ddd";

            ctx.lineWidth=4;

            ctx.beginPath();

            ctx.moveTo(-40,0);
            ctx.lineTo(40,0);

            ctx.stroke();

            ctx.beginPath();

            ctx.arc(
                0,0,
                20,
                0,
                Math.PI*2
            );

            ctx.stroke();
        }

        if(d.type===6){

            ctx.fillStyle=
            "#555";

            ctx.fillRect(
                -30,-15,
                60,30
            );

            ctx.fillStyle=
            "#222";

            ctx.fillRect(
                -10,-10,
                20,20
            );
        }

        ctx.restore();

        d.rotation +=
        d.rotSpeed;
    }
}

function checkCollision(){

    for(let d of debris){

        const dx=
        rocket.x-d.x;

        const dy=
        rocket.y-d.y;

        const distance=
        Math.sqrt(
            dx*dx+
            dy*dy
        );

        if(d.cooldown>0){

            d.cooldown--;
        }

        if(
            distance <
            d.size/2 +
            rocket.radius &&

            d.cooldown<=0
        ){

            health--;

            d.cooldown=90;

            if(
                health<=0
            ){

                gameOver=
                true;
            }
        }
    }
}

function drawHearts(){

    ctx.font=
    "28px Arial";

    for(
        let i=0;
        i<health;
        i++
    ){

        ctx.fillStyle=
        "red";

        ctx.fillText(
            "❤",
            20,
            40+i*25
        );
    }
}

function drawParticles(){

    for(let p of particles){

        ctx.fillStyle=
        "rgba(255,140,0,"+
        (p.life/20)+")";

        ctx.beginPath();

        ctx.arc(
            p.x-camera.x,
            p.y-camera.y,
            3,
            0,
            Math.PI*2
        );

        ctx.fill();

        p.x += p.vx;
        p.y += p.vy;

        p.life--;
    }

    particles =
    particles.filter(
        p=>p.life>0
    );
}
function stationShop(){

    for(let s of stations){

        const dx =
        rocket.x - s.x;

        const dy =
        rocket.y - s.y;

        const distance =
        Math.sqrt(
            dx*dx +
            dy*dy
        );

        if(distance < 100){

            ctx.fillStyle =
            "white";

            ctx.font =
            "20px Arial";

            ctx.fillText(
                "Натисни E для ремонту (1 монета)",
                s.x-camera.x-120,
                s.y-camera.y-60
            );

            if(
                (keys["e"] ||
                 keys["E"]) &&

                coins >= 1 &&
                health < maxHealth
            ){

                coins--;

                health++;

                keys["e"]=false;
                keys["E"]=false;
            }
        }
    }
}

function drawUI(){

    ctx.fillStyle =
    "gold";

    ctx.font =
    "28px Arial";

    ctx.fillText(
        "🪙 " + coins,
        20,
        330
    );

    ctx.fillStyle =
    "white";

    ctx.fillText(
        "Швидкість: " +
        Math.floor(
            Math.sqrt(
                rocket.vx*rocket.vx +
                rocket.vy*rocket.vy
            ) * 10
        ),
        20,
        370
    );

    ctx.fillText(
        "X: " +
        Math.floor(
            rocket.x
        ),
        20,
        410
    );

    ctx.fillText(
        "Y: " +
        Math.floor(
            rocket.y
        ),
        20,
        450
    );
}

function drawGameOver(){

    if(!gameOver)
    return;

    ctx.fillStyle =
    "rgba(0,0,0,0.85)";

    ctx.fillRect(
        0,
        0,
        canvas.width,
        canvas.height
    );

    ctx.textAlign =
    "center";

    ctx.fillStyle =
    "white";

    ctx.font =
    "80px Arial";

    ctx.fillText(
        "GAME OVER",
        canvas.width/2,
        canvas.height/2-80
    );

    ctx.font =
    "40px Arial";

    ctx.fillText(
        "Зібрано монет: " +
        coins,
        canvas.width/2,
        canvas.height/2
    );

    ctx.fillText(
        "Натисни F5 для рестарту",
        canvas.width/2,
        canvas.height/2+80
    );

    ctx.textAlign =
    "left";
}

function gameLoop(){

    ctx.clearRect(
        0,
        0,
        canvas.width,
        canvas.height
    );

    moveRocket();

    updateCamera();

    drawFarStars();

    drawNebulas();

    drawStars();

    drawPlanets();

    drawCoins();

    collectCoins();

    drawStations();

    stationShop();

    drawDebris();

    checkCollision();

    drawRocket();

    drawParticles();

    drawHearts();

    drawUI();

    drawGameOver();

    requestAnimationFrame(
        gameLoop
    );
}

gameLoop();

</script>

</body>
</html>
